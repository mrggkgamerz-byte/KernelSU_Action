CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/mrggkgamerz-byte/kernel_xiaomi_fog
KERNEL_SOURCE_BRANCH=andromeda-mk2
KERNEL_CONFIG=vendor/fog-perf_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

KERNEL_NAME=KanhaKernel
ADD_LOCALVERSION_TO_FILENAME=true

EXTRA_CMDS="LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes"

# ★ EKHANE CUSTOM_CMDS EMPTY RAKHA HOLO ★
CUSTOM_CMDS=""

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=false

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

KSU_VARIANT=resukisu
KSU_REF=
KSU_HOOK_MODE=auto
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true

# ★ EKHANE MAGIC LINE TA BOSHANO HOLO ★
EXTRA_DEFCONFIG="CONFIG_MODULE_SIG=n CONFIG_MODULE_SIG_FORCE=n CONFIG_MODULE_SIG_ALL=n CONFIG_MODULE_FORCE_LOAD=y"

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=false
REMOVE_UNUSED_PACKAGES=true
